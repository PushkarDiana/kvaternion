<Window x:Class="Kvaternion.Pages.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kvaternion.Pages"
        mc:Ignorable="d"
        Title="Новый товар" Height="540" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Добавление" FontSize="18" FontWeight="Bold" Margin="5"/>

        <TextBlock Text="Артикул" Foreground="Gray" Margin="5"/>
        <TextBox x:Name="txtArticle" Height="28" VerticalContentAlignment="Center" Margin="5"/>

        <TextBlock Text="Наименование" Foreground="Gray" Margin="5"/>
        <TextBox x:Name="txtName" Height="28" VerticalContentAlignment="Center" Margin="5"/>

        <TextBlock Text="Категория" Foreground="Gray" Margin="5"/>
        <ComboBox x:Name="cbCategory" DisplayMemberPath="Name" Height="28" Margin="5"/>

        <TextBlock Text="Единица измерения" Foreground="Gray" Margin="5"/>
        <TextBox x:Name="txtUnit" Height="28" VerticalContentAlignment="Center" Margin="5"/>

        <TextBlock Text="Кол-во" Foreground="Gray" Margin="5"/>
        <TextBox x:Name="txtInitialQuantity" Height="28" VerticalContentAlignment="Center" Margin="5"/>

        <TextBlock Text="Склад / Объект" Foreground="Gray" Margin="5"/>
        <ComboBox x:Name="cbWarehouse" DisplayMemberPath="Name" Height="28" Margin="5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Создать" Width="100" Height="30" Margin="5" 
                    Background="#FF8C00" Foreground="White" Click="btnSave_Click"/>
            <Button Content="Отмена" Width="80" Height="30" Margin="5" Click="btnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
