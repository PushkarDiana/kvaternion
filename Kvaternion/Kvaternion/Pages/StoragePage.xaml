<Page x:Class="Kvaternion.Pages.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvaternion.Pages"
      mc:Ignorable="d" 
       Title="Складской учет"
  Background="Transparent">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="10" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions >
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Поиск по наименованию:" Foreground="#555" Margin="10,0,10,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Категория:" Foreground="#555" Margin="10,0,10,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Склад/Объект:" Foreground="#555" Margin="10,0,10,2"/>
                <TextBox x:Name="txtSearch" Grid.Row="1" Grid.Column="0" Width="180" Height="30" Margin="10,0,10,0" VerticalContentAlignment="Center" TextChanged="UpdateFilters"/>
                <ComboBox x:Name="cbCategory" Grid.Row="1" Grid.Column="1" Width="140" Height="30" Margin="10,0,10,0" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectionChanged="UpdateFilters"/>
                <ComboBox x:Name="cbWarehouse" Grid.Row="1" Grid.Column="2" Width="160" Height="30" Margin="10,0,10,0" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectionChanged="UpdateFilters"/>
                <Button Content="+ Добавить" Grid.Row="1" Grid.Column="4" Background="#FF8C00" Foreground="White" Width="110" Height="30" Margin="10,0,10,0" VerticalAlignment="Center" Click="btnAddProduct_Click"/>
                <Button Content="Экспорт в Excel" Grid.Row="1" Grid.Column="3" 
                   Background="#FF3DA66A" Foreground="White" Width="120" Height="30"  Click="btnExport_Click"/>
            </Grid>
        </Border>
        <DataGrid x:Name="dgStorage" Grid.Row="1" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="120"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="120"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,5,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="60"/>

                <DataGridTemplateColumn Width="180" Header="Действия">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Изменить" Background="#FF444444" Foreground="White" Width="80" Height="25" Margin="5" Click="btnEdit_Click"/>
                                <Button Content="Удалить" Background="#FF950000" Foreground="White" Width="70" Height="25" Margin="5" Click="btnDelete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="#EEE" Padding="10" Margin="10,0,10,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Всего позиций: " Foreground="#555"/>
                <TextBlock x:Name="lblTotalCount" Text="0" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock Text="Низкий остаток: " Foreground="#555"/>
                <TextBlock x:Name="lblLowStockCount" Text="0" FontWeight="Bold" Foreground="Red"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
