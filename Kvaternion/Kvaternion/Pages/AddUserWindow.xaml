<Window x:Class="Kvaternion.Pages.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kvaternion.Pages"
        mc:Ignorable="d"
        Title="Данные сотрудника" Height="620" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Карточка сотрудника" FontSize="18" FontWeight="Bold" Margin="10" Foreground="#FF414141"/>
            <TextBlock Text="ФИО:" Foreground="Gray" Margin="5"/>
            <TextBox x:Name="txtFullName" Height="30" Margin="5" VerticalContentAlignment="Center"/>
            <TextBlock Text="Логин:" Foreground="Gray" Margin="5"/>
            <TextBox x:Name="txtLogin" Height="30" Margin="5" VerticalContentAlignment="Center"/>
            <TextBlock Text="Пароль:" Foreground="Gray" Margin="5"/>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="txtPassword" Height="30" VerticalContentAlignment="Center" PasswordChanged="txtPassword_PasswordChanged" Grid.Column="0"/>

                <TextBox x:Name="txtPasswordVisible" Height="30" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="txtPasswordVisible_TextChanged" Grid.Column="0"/>

                <Button x:Name="btnShowPass" Grid.Column="1" Width="30" Content="👁️" 
            PreviewMouseDown="btnShowPass_PreviewMouseDown" 
            PreviewMouseUp="btnShowPass_PreviewMouseUp"
            Background="Transparent" BorderBrush="{x:Null}" Cursor="Hand"/>
            </Grid>
            <TextBlock Text="Роль в системе:" Foreground="Gray" Margin="5"/>
            <ComboBox x:Name="cbRoles" Height="30" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock Text="Телефон:" Foreground="Gray" Margin="5"/>
            <TextBox x:Name="txtPhone" Height="30" Margin="5" VerticalContentAlignment="Center" MaxLength="20" ToolTip="Введите номер телефона" PreviewTextInput="txtPhone_PreviewTextInput" TextChanged="txtPhone_TextChanged"/>
            <TextBlock Text="E-mail:" Foreground="Gray" Margin="5"/>
            <TextBox x:Name="txtEmail" Height="30" Margin="5" VerticalContentAlignment="Center" MaxLength="50" ToolTip="Введите электронную почту"/>
            <CheckBox x:Name="chbIsActive" Content="Доступ разрешен" IsChecked="True" VerticalAlignment="Center" Margin="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="Отмена" Width="80" Height="30" Margin="5" Click="btnCancel_Click"/>
                <Button Content="Сохранить" Width="100" Height="30" Margin="5" Background="#FF8C00" Foreground="White" Click="btnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
