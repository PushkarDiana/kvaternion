<Page x:Class="Kvaternion.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvaternion.Pages"
      mc:Ignorable="d" 
     Title="Личный кабинет" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="10">
                        <Grid Width="150" Height="150" Margin="10">
                            <Border x:Name="brdAvatarRoot" CornerRadius="75" BorderBrush="#DDD" BorderThickness="1" Background="White" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="brdInitials" Background="#FF505050" CornerRadius="75" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock x:Name="txtInitials" Text="П" Foreground="White" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="imgProfile" Stretch="UniformToFill" Visibility="Collapsed">
                                        <Image.Clip>
                                            <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                            <Button x:Name="btnDeletePhoto" Click="btnDeletePhoto_Click" Content="🗑️" Width="35" Height="35" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="17"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                        <Button Content="Сменить фото" Click="btnChangePhoto_Click" Style="{StaticResource OrangeButton}" Height="35" Margin="10"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Контактная информация" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,15"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="5">
                                    <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtFullName" Text="Пушкар Диана Сергеевна"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Должность" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtRole" Text="Администратор" IsReadOnly="True" Background="#F9F9F9"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtPhone" MaxLength="20" Text="8" PreviewTextInput="txtPhone_PreviewTextInput" TextChanged="txtPhone_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtEmail" MaxLength="50"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="White" CornerRadius="15" Padding="25">
                    <StackPanel>
                        <TextBlock Text="Смена пароля" FontSize="16" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,15"/>

                        <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="pbOldPass" Height="35" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtOldPassVisible" Height="35" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁️" Width="35" Background="Transparent" BorderBrush="{x:Null}" Cursor="Hand"
                    PreviewMouseDown="btnShowOldPass_MouseDown" PreviewMouseUp="btnShowOldPass_MouseUp"/>
                        </Grid>

                        <Separator Margin="0,15" Background="#EEE"/>

                        <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="pbNewPass" Height="35" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtNewPassVisible" Height="35" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁️" Width="35" Background="Transparent" BorderBrush="{x:Null}" Cursor="Hand"
                    PreviewMouseDown="btnShowNewPass_MouseDown" PreviewMouseUp="btnShowNewPass_MouseUp"/>
                        </Grid>

                        <TextBlock Text="Подтвердите новый пароль" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="pbConfirmPass" Height="35" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtConfirmPassVisible" Height="35" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁️" Width="35" Background="Transparent" BorderBrush="{x:Null}" Cursor="Hand"
                    PreviewMouseDown="btnShowConfirmPass_MouseDown" PreviewMouseUp="btnShowConfirmPass_MouseUp"/>
                        </Grid>

                        <Button Content="Сохранить изменения" Style="{StaticResource OrangeButton}" Width="220" HorizontalAlignment="Right" Margin="0,15,0,0" Click="btnSave_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
