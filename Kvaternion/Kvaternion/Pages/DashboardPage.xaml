<Page x:Class="Kvaternion.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvaternion.Pages"
      mc:Ignorable="d" 
      Title="Панель управления" Background="{StaticResource LightBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="txtWelcome" Text="Добро пожаловать!" Style="{StaticResource HeaderTitle}" HorizontalAlignment="Left" Margin="10"/>
            <UniformGrid Columns="3">
                <Border Background="{StaticResource WhiteBrush}" Margin="10" Padding="20" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="ТОВАРЫ" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtProductCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryOrange}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource WhiteBrush}" Margin="10" Padding="20" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="СКЛАДЫ" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtWarehouseCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource DarkGray}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource WhiteBrush}" Margin="10" Padding="20" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="ЗА СЕГОДНЯ" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtLogCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryOrange}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Style="{StaticResource FieldLabel}" Margin="15" HorizontalAlignment="Center"/>
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Добавить товар" Style="{StaticResource OrangeButton}" Width="180" Margin="10" Click="btnAddProduct_Click"/>
                <Button Content="Оформить поставку" Style="{StaticResource OrangeButton}" Width="180" Margin="10" Click="btnNewSupply_Click"/>
                <Button Content="Отчет по остаткам" Style="{StaticResource OrangeButton}" Width="180" Margin="10" Background="{StaticResource DarkGray}" Click="btnReport_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

