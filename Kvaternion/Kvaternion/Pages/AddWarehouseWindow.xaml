<Window x:Class="Kvaternion.Pages.AddWarehouseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kvaternion.Pages"
        mc:Ignorable="d"
       Title="Добавление объекта" Height="320" Width="400" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Новый строительный объект" FontSize="18" FontWeight="Bold" Margin="10"/>
            <TextBlock Text="Название:" Foreground="Gray" Margin="10,5,0,0"/>
            <TextBox x:Name="txtName" Height="30" Margin="10" VerticalContentAlignment="Center"/>
            <TextBlock Text="Адрес:" Foreground="Gray" Margin="10,5,0,0"/>
            <TextBox x:Name="txtAddress" Height="30" Margin="10" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="Отмена" Width="80" Height="30" Margin="10" Background="#DDD" Click="btnCancel_Click"/>
                <Button Content="Сохранить" Width="100" Height="30" Margin="10" Background="#FF8C00" Foreground="White" Click="btnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
