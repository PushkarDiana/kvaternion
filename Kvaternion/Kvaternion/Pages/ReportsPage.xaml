<Page x:Class="Kvaternion.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvaternion.Pages"
      mc:Ignorable="d" 
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
     Title="Аналитика и Отчеты" Background="#F4F7F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Аналитика запасов ООО «Кватерион Групп»" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="5" Foreground="#7F8C8D"/>
            <ComboBox x:Name="cbCategoryFilter" Width="180" Height="30" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Filters_SelectionChanged"/>
            <TextBlock Text="Объект:" VerticalAlignment="Center" Margin="20,5,5,5" Foreground="#7F8C8D"/>
            <ComboBox x:Name="cbWarehouseFilter" Width="180" Height="30" Margin="5"
              DisplayMemberPath="Name" SelectedValuePath="Id"
              SelectionChanged="Filters_SelectionChanged"/>

            <Button Content="Сбросить всё" Width="120" Height="30" Margin="20,10,10,10" 
            Click="btnReset_Click" Background="#444" Foreground="White" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="5,0,5,15">

                <Border Background="White" Margin="5" CornerRadius="10" BorderBrush="#FF8C00" BorderThickness="0,4,0,0">
                    <StackPanel Margin="15" HorizontalAlignment="Center">
                        <TextBlock Text="Всего запасов (ед.)" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="txtTotalQuantity" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Margin="5" CornerRadius="10" BorderBrush="#27AE60" BorderThickness="0,4,0,0">
                    <StackPanel Margin="15" HorizontalAlignment="Center">
                        <TextBlock Text="Объектов задействовано" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="txtTotalWarehouses" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Margin="5" CornerRadius="10" BorderBrush="#2980B9" BorderThickness="0,4,0,0">
                    <StackPanel Margin="15" HorizontalAlignment="Center">
                        <TextBlock Text="Всего категорий" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="txtTotalCategories" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Grid.Row="1" Columns="2" Margin="5">
                <Border Background="White" Margin="10" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Запасы по объектам (ед.)" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="10"/>
                        <lvc:PieChart x:Name="pieChart" Grid.Row="1" LegendLocation="Bottom" Margin="5"/>
                    </Grid>
                </Border>
                <Border Background="White" Margin="10" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Запасы по категориям" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="10"/>
                        <lvc:CartesianChart x:Name="columnChart" Grid.Row="1" Margin="5">
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Категории" Labels="{Binding CategoryLabels}">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Количество" LabelFormatter="{Binding Formatter}"/>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>
    </Grid>
</Page>
