<Page x:Class="Kvaternion.Pages.WarehousesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvaternion.Pages"
      mc:Ignorable="d" 
   Title="Объекты и Склады" Background="#F4F7F9">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Строительные объекты" FontSize="24" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

            <Button Content="+ Новый объект" Margin="20" Padding="15,5" Background="#FF8C00" Foreground="White" BorderThickness="0" VerticalAlignment="Center" Click="btnAddWarehouse_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icWarehouses" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" MinHeight="220" Margin="10" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Address}" FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="5"/>
                                    <Border Background="#FFF1F0" CornerRadius="4" Margin="5" Padding="5" Visibility="{Binding HasLowStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠" Foreground="#CF1322" Margin="0,0,5,0"/>
                                            <TextBlock Text="Требуется пополнение" Foreground="#CF1322" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Separator Background="#F0F0F0" Margin="10"/>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Позиций на складе: " FontSize="13" Foreground="#555"/>
                                        <TextBlock Text="{Binding ItemsCount}" FontWeight="Bold" Foreground="#FF8C00" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Удалить" Foreground="#E74C3C" Margin="5" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="btnDeleteWarehouse_Click"/>
                                    <Button Content="Изменить" Foreground="#F39C12" Margin="5" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="btnEditWarehouse_Click"/>
                                    <Button Content="Просмотр" Foreground="#3498DB" FontWeight="Bold" Margin="5" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="btnManage_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
