<Page x:Class="Kvaternion.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kvaternion.Pages"
      mc:Ignorable="d" 
     Title="О системе" Background="{StaticResource LightBg}">

    <Grid Margin="30">
        <Border Background="{StaticResource WhiteBrush}" CornerRadius="8" MaxWidth="700" VerticalAlignment="Top" Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderTitle}" Margin="10">
                    <Run Text="ИС" Foreground="{StaticResource PrimaryOrange}"/>
                    <Run Text="KVATERION GROUP" Foreground="{StaticResource DarkGray}"/>
                </TextBlock>
                <Separator Background="#EEEEEE" Margin="20"/>
                <TextBlock Text="Автоматизация складского учета"  Style="{StaticResource FieldLabel}"  FontSize="16" HorizontalAlignment="Center" Margin="20"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DarkGray}" LineHeight="22" TextAlignment="Center" Text="Специализированное программное обеспечение для управления материально-техническими ресурсами на объектах ООО «Кватерион Групп». Система обеспечивает контроль движения ТМЦ от поступления на склад до списания на строительный участок."/>
                <UniformGrid Columns="2" Margin="30">
                    <StackPanel Margin="10">
                        <TextBlock Text="ВЕРСИЯ" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="1.0.2 Stable" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="ТЕХНОЛОГИИ" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="C# / .NET 8 / WPF" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
                <Border Background="#FFF9F3" Padding="15" CornerRadius="4" BorderBrush="{StaticResource PrimaryOrange}" BorderThickness="0,0,0,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Разработчик:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text="Пушкар Диана Сергеевна" Foreground="{StaticResource DarkGray}" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="2026 © ООО «Кватернион Групп»" HorizontalAlignment="Center" Margin="30" Foreground="#999999" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
