<Window x:Class="Kvaternion.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kvaternion"
        mc:Ignorable="d"
            Title="Авторизация" 
    Height="460" Width="360"
    WindowStartupLocation="CenterScreen" Background="{StaticResource LightBg}"
    ResizeMode="NoResize">
    <Grid VerticalAlignment="Center">
        <Border Background="{StaticResource WhiteBrush}" CornerRadius="5" Margin="20" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Margin="10">
                <Image Source="/Image/logo.jpg" Height="60" Margin="10"/>
                <TextBlock Text="ВХОД В СИСТЕМУ" Style="{StaticResource HeaderTitle}" Margin="10"/>
                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin" Margin="5"/>
                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="txtPassword" Grid.Column="0" Margin="0" Visibility="Visible"/>
                    <TextBox x:Name="txtPasswordVisible" Grid.Column="0" Margin="0" Visibility="Collapsed"/>
                    <Button x:Name="btnTogglePass" Grid.Column="1" Content="&#xE7B3;" Style="{StaticResource IconButtonStyle}" Width="20" Margin="2" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="btnTogglePass_Click"/>
                </Grid>
                <Button Content="ВОЙТИ" x:Name="btnLogin" Style="{StaticResource OrangeButton}" Margin="20"
                    Click="btnLogin_Click"/>
                <TextBlock x:Name="lblError" Style="{StaticResource ErrorText}" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
