<Window x:Class="Kvaternion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kvaternion"
        mc:Ignorable="d"
            Title="Кватернион Групп — Система учета ТМР" 
    Height="760" Width="1100"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource LightBg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkGray}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="10">
                    <Image Source="/Image/logo.jpg" Margin="5"/>
                    <Separator Background="#5A5A5A" Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="5" x:Name="MenuStack">
                    <Button x:Name="btnDashboard" Content="🏠 Главная панель" Style="{StaticResource MenuButton}" Click="btnDashboard_Click"/>
                    <Button x:Name="btnStorage" Content="📦 Учет ТМР" Style="{StaticResource MenuButton}" Click="btnStorage_Click"/>
                    <Button x:Name="btnWarehouses" Content="🏗 Объекты / Склады" Style="{StaticResource MenuButton}" Click="btnWarehouses_Click"/>
                    <Button x:Name="btnInput" Content="➕ Поступления" Style="{StaticResource MenuButton}" Click="btnInput_Click"/>
                    <Button x:Name="btnReports" Content="📊 Аналитика" Style="{StaticResource MenuButton}" Click="btnReports_Click"/>
                    <Button x:Name="btnUsers" Content="👥 Пользователи" Style="{StaticResource MenuButton}" Click="btnUsers_Click"/>
                    <Button x:Name="btnProfile" Content="👤 Личный кабинет" Click="btnProfile_Click" Style="{StaticResource MenuButton}"/>
                    <Button x:Name="btnOSisteme" Content="ℹ️ О системе" Click="btnInfo_Click" Style="{StaticResource MenuButton}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="10">
                    <Button Content="⬅ Выход" Style="{StaticResource MenuButton}"  Foreground="#FF7F8C8D" FontWeight="Bold" Click="btnLogout_Click" Margin="0,5"/>
                    <Button Content="❌ Завершить работу" Style="{StaticResource MenuButton}" Foreground="#FFE92A2A" FontWeight="Bold" Click="btnExitApp_Click" Margin="0,5"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="1"/>
                </Border.Effect>
                <Grid Margin="20,0">
                    <TextBlock x:Name="txtPageTitle" Text="Складской учет" VerticalAlignment="Center" 
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource DarkGray}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="10,0">
                            <TextBlock x:Name="tbWelcome" Text="Добро пожаловать," FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="txtUserName" Text="Диана С." FontSize="14" FontWeight="Bold" 
                                 VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Grid Margin="10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="brdUserInitial" Width="35" Height="35" Fill="{StaticResource PrimaryOrange}"/>
                            <TextBlock x:Name="txtUserInitial" Text="Д" Foreground="White" FontWeight="Bold" 
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Image x:Name="imgUserPhoto" Width="35" Height="35" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="17.5,17.5" RadiusX="17.5" RadiusY="17.5"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
